FROM pytorch/pytorch:2.5.1-cuda12.4-cudnn9-runtime
WORKDIR /app
RUN pip install --no-cache-dir fastapi==0.115.12 transformers==4.49.0 accelerate==1.4.0 uvicorn[standard]==0.34.0
COPY serving/baseline.py /app/baseline.py
EXPOSE 8000
CMD ["uvicorn", "baseline:app", "--host", "0.0.0.0", "--port", "8000"]